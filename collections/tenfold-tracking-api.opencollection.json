{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tenfold Analytics Tracking API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tracking",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Track a custom event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tenfold.com/v2/tracking"
          },
          "docs": "Track a custom event"
        }
      ]
    }
  ],
  "bundled": true
}